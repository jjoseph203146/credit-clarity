NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
INTERNAL_API_SECRET=

# Authorizes the scheduled /api/cleanup sweep (vercel.json). Vercel Cron sends
# this as `Authorization: Bearer <value>`. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional cleanup tuning — defaults shown.
# Anonymous, never-paid reports older than this are deleted (Storage + row).
CLEANUP_ABANDONED_REPORT_DAYS=7
# Pending payments older than this are marked failed.
CLEANUP_PENDING_PAYMENT_HOURS=24

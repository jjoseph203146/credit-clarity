# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS entirely — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic ---
# Server only. Billable.
ANTHROPIC_API_KEY=

# Shared secret gating /api/analyze and /api/cleanup.
INTERNAL_API_SECRET=

# --- Public-facing legal details ---
# Required before launch: these render verbatim in the Terms and Privacy
# Policy. Unset values fall back to loud placeholders so an unconfigured
# deploy reads as unfinished instead of shipping a dead contact address.
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_GOVERNING_LAW=

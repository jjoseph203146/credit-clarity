# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS entirely — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic ---
# Server only. Billable.
ANTHROPIC_API_KEY=

# Shared secret gating /api/analyze and /api/cleanup.
INTERNAL_API_SECRET=

# --- Error alerting (optional but strongly recommended) ---
# Incoming-webhook URL for error alerts. Slack and Discord both accept the
# {"text": "..."} body this sends, so either works with no adapter. For
# Discord, append /slack to the webhook URL. Unset means errors are still
# logged as structured JSON, but nothing pages anyone.
ERROR_WEBHOOK_URL=
